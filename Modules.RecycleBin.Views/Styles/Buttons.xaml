<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Modules.RecycleBin.Views.Controls">

    <Style
        x:Key="GroupItemTitleButtonStyle"
        TargetType="{x:Type Button}">
        <Style.Resources>
            <controls:BoolToChevronConverter x:Key="ChevronConverter" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{Binding UIScaler.FontSize.Medium, Source={StaticResource UIScaler}}" />
        <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0 0 4 0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="{Binding UIScaler.FontSize.Smallest, Source={StaticResource UIScaler}}"
                                FontWeight="Normal"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding IsOpen, Converter={StaticResource ChevronConverter}}"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextHintingMode="Fixed"
                                TextOptions.TextRenderingMode="ClearType" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextHintingMode="Fixed"
                                TextOptions.TextRenderingMode="ClearType"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface3}" />
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>