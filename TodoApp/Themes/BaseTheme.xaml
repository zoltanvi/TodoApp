<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TransparentBrush" Color="{DynamicResource Transparent}" />

    <LinearGradientBrush x:Key="TransparentPatternBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#888888" />
        <GradientStop Offset="0.5" Color="#888888" />
        <GradientStop Offset="0.5" Color="#FFFFFFFF" />
        <GradientStop Offset="1" Color="#FFFFFFFF" />
    </LinearGradientBrush>

    <!--  Elevation shadow system: increasing prominence from 1 (subtle) to 4 (maximum)  -->
    <DropShadowEffect x:Key="Elevation1" x:Shared="False" BlurRadius="4"  Opacity="0.10" ShadowDepth="0" Color="Black" />
    <DropShadowEffect x:Key="Elevation2" x:Shared="False" BlurRadius="8"  Opacity="0.16" ShadowDepth="0" Color="Black" />
    <DropShadowEffect x:Key="Elevation3" x:Shared="False" BlurRadius="16" Opacity="0.24" ShadowDepth="0" Color="Black" />
    <DropShadowEffect x:Key="Elevation4" x:Shared="False" BlurRadius="24" Opacity="0.32" ShadowDepth="0" Color="Black" />

</ResourceDictionary>
