<commonPages:GenericBasePage
    x:Class="Modules.Settings.Views.Pages.CategorySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commonPages="clr-namespace:Modules.Common.Views.Pages;assembly=Modules.Common.Views"
    xmlns:controls="clr-namespace:Modules.Settings.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Modules.Settings.Views.Pages"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800"
    d:DataContext="{d:DesignInstance Type=pages:CategorySettingsPageViewModel}"
    x:TypeArguments="pages:CategorySettingsPageViewModel"
    Title="CategorySettingsPage">

    <ScrollViewer Style="{StaticResource TodoAppScrollViewer}">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical" Grid.Row="1">

                <!-- Font size -->
                <Border Style="{StaticResource SettingsItemStyle}">
                    <DockPanel Style="{StaticResource SettingsDockPanelStyle}">
                        <controls:FontSizeSliderControl
                            Description="Font size"
                            PreviewFontSize="{Binding AppSettings.CategorySettings.FontSize, Source={StaticResource AppSettings}, Mode=TwoWay}"
                            Min="10"
                            Max="24"
                            Steps="1" />
                    </DockPanel>
                </Border>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</commonPages:GenericBasePage>
