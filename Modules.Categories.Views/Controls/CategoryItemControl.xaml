<UserControl
    x:Class="Modules.Categories.Views.Controls.CategoryItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Modules.Common.Views.ValueConverters;assembly=Modules.Common.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Modules.Categories.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="CategoryListItem"
    d:DataContext="{d:DesignInstance Type=local:CategoryItemViewModel}"
    d:DesignHeight="60"
    d:DesignWidth="350"
    mc:Ignorable="d">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem
                Command="{Binding Path=PlacementTarget.DataContext.AddSubcategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                Header="Add subcategory">
                <MenuItem.Icon>
                    <Label
                        Content="{StaticResource IconAdd}"
                        Foreground="{DynamicResource OnSurfaceVariant}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Path=PlacementTarget.DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                Header="Rename">
                <MenuItem.Icon>
                    <Label
                        Content="{StaticResource IconEdit}"
                        Foreground="{DynamicResource OnSurfaceVariant}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Command="{Binding Path=PlacementTarget.DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                Header="Delete">
                <MenuItem.Icon>
                    <Label
                        Content="{StaticResource IconTrash}"
                        Foreground="{DynamicResource OnSurfaceVariant}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
                Command="{Binding Path=PlacementTarget.DataContext.MoveToRootCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                Header="Move to root"
                Visibility="{Binding Path=PlacementTarget.DataContext.IsSubcategory, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BoolToVisibilityConverter}}">
                <MenuItem.Icon>
                    <Label
                        Content="{StaticResource IconMoveTo}"
                        Foreground="{DynamicResource OnSurfaceVariant}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Button
        Padding="0 1"
        Command="{Binding Path=ChangeCategoryCommand}"
        CommandParameter="{Binding DataContext, ElementName=CategoryListItem}"
        Cursor="Hand"
        Foreground="{DynamicResource OnPrimaryContainer}"
        ToolTip="{Binding Name}">
        <Button.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Source={StaticResource UIScaler}, Path=UIScaler.ScaleValue}" ScaleY="{Binding Source={StaticResource UIScaler}, Path=UIScaler.ScaleValue}" />
        </Button.LayoutTransform>
        <Button.Style>
            <Style
                BasedOn="{StaticResource ButtonHoverStyle}"
                TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Opacity="{TemplateBinding Opacity}" />

                                    <!-- Expand/Collapse chevron, only visible when category has children -->
                                    <Button
                                        x:Name="PART_ExpandButton"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Width="20"
                                        Margin="2 0 0 0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleExpandCommand}"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent" Padding="1">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <Label
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Style="{StaticResource IconLabelStyle}">
                                            <Label.Content>
                                                <Binding Path="IsExpanded">
                                                    <Binding.Converter>
                                                        <local:BoolToChevronConverter />
                                                    </Binding.Converter>
                                                </Binding>
                                            </Label.Content>
                                        </Label>
                                    </Button>

                                    <!-- Category name or rename textbox -->
                                    <ContentPresenter
                                        Grid.Column="2"
                                        Margin="6 4"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center" />

                                    <!-- Delete button -->
                                    <Button
                                        x:Name="PART_DeleteButton"
                                        Grid.Column="3"
                                        Command="{Binding Path=DeleteCategoryCommand}"
                                        CommandParameter="{Binding DataContext, ElementName=CategoryListItem}"
                                        Cursor="Hand"
                                        FontSize="{Binding UIScaler.FontSize.Small, Source={StaticResource UIScaler}}"
                                        Style="{StaticResource ButtonIconCloseStyle}"
                                        ToolTip="Delete category"
                                        Visibility="Hidden">

                                        <Label
                                            Grid.Column="0"
                                            Margin="3 0"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource IconDeleteX}"
                                            FontSize="12"
                                            Style="{StaticResource IconLabelStyle}" />
                                    </Button>

                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_DeleteButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter TargetName="PART_DeleteButton" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
                    </Trigger>

                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <converters:EqualityConverter />
                                </MultiBinding.Converter>
                                <Binding Path="Id" />
                                <Binding
                                    Path="ActiveCategoryId"
                                    RelativeSource="{RelativeSource AncestorType={x:Type local:CategoryItemControl}}" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>
        </Button.Style>

        <Grid>
            <!-- Normal display: category name -->
            <TextBlock
                FontSize="13"
                FontWeight="Normal"
                Text="{Binding Name}"
                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityNegatedConverter}}">

                <TextBlock.Style>
                    <Style
                        BasedOn="{StaticResource CategoryTextBlockStyle}"
                        TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
                            </Trigger>

                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <converters:EqualityConverter />
                                        </MultiBinding.Converter>
                                        <Binding Path="Id" />
                                        <Binding
                                            Path="ActiveCategoryId"
                                            RelativeSource="{RelativeSource AncestorType={x:Type local:CategoryItemControl}}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
                            </DataTrigger>

                        </Style.Triggers>
                        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />

                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Rename mode: editable textbox -->
            <TextBox
                x:Name="RenameTextBox"
                FontSize="13"
                Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}"
                local:RenameBehavior.IsInRenameMode="{Binding IsRenaming}" />
        </Grid>

    </Button>

</UserControl>
